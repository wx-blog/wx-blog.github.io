---
import BaseLayout from '../layouts/BaseLayout.astro';
import { collectTags, getPublishedPosts } from '../utils/posts';

const posts = await getPublishedPosts();
const popular = collectTags(posts).slice(0, 6);
---

<BaseLayout
  title="搜索"
  description="在全部文章里搜索标题、标签和正文。"
>
  <div class="wrap">
    <header class="page-hero">
      <p class="page-hero__eyebrow" data-reveal>SEARCH</p>
      <h1 class="page-hero__title" data-reveal style="--d:.05s">搜一下。</h1>
      <p class="page-hero__lede" data-reveal style="--d:.12s">
        {posts.length} 篇文章的标题、标签和正文都会参与匹配。多个关键词用空格分开，会取同时命中的结果。
      </p>
    </header>

    <div data-reveal style="--d:.18s">
      <label class="search-box">
        <svg
          width="18"
          height="18"
          viewBox="0 0 18 18"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          aria-hidden="true"
        >
          <circle cx="8" cy="8" r="5.2"></circle>
          <path d="m12 12 4 4" stroke-linecap="round"></path>
        </svg>
        <input
          id="search-input"
          type="search"
          placeholder="试试：LVM、firewalld、Ceph、Ansible…"
          autocomplete="off"
          spellcheck="false"
          aria-label="搜索文章"
        />
      </label>

      <p class="search-hint">
        按 <kbd>/</kbd> 可直接聚焦搜索框，按 <kbd>Esc</kbd> 清空。
      </p>

      {
        popular.length > 0 && (
          <div class="search-chips" data-reveal style="--d:.16s">
            <span class="search-chips__label mono-label">POPULAR</span>
            {popular.map(([tag, count]) => (
              <a class="search-chip" href={`/search/?q=${encodeURIComponent(tag)}`}>
                {tag}
                <span class="search-chip__count">{String(count).padStart(2, '0')}</span>
              </a>
            ))}
          </div>
        )
      }

      <p class="search-hint" id="search-status" role="status" aria-live="polite"></p>
      <ol class="search-results" id="search-results"></ol>

      <noscript>
        <p class="search-empty">
          搜索需要 JavaScript。你也可以直接<a href="/blog/">翻阅全部文章</a>或<a href="/tags/">按标签浏览</a>。
        </p>
      </noscript>
    </div>
  </div>
</BaseLayout>

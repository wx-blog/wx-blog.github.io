---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../consts';
import {
  getNeighbors,
  getPublishedPosts,
  postTimestamp,
  postUrl,
  tagUrl,
} from '../../utils/posts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

const posts = await getPublishedPosts();
const { newer, older } = getNeighbors(posts, post.id);

/* 目录只收二、三级标题：一级就是文章标题，再深一层会太碎 */
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);

/* 结构化数据。日期用带时分的完整时间，避免同日多篇在搜索结果里
   排序混乱；修改时间优先取 updatedDate。 */
const siteUrl = Astro.site?.href ?? SITE.url;
const postHref = new URL(postUrl(post.id), siteUrl).href;
const imageHref = new URL(`og/${post.id}.png`, siteUrl).href;
const publishedAt = new Date(postTimestamp(post)).toISOString();
const modifiedAt = (post.data.updatedDate ?? post.data.pubDate).toISOString();

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: post.data.title,
    description: post.data.description,
    image: [imageHref],
    datePublished: publishedAt,
    dateModified: modifiedAt,
    author: { '@type': 'Person', name: SITE.author, url: SITE.url },
    publisher: { '@type': 'Person', name: SITE.author, url: SITE.url },
    mainEntityOfPage: { '@type': 'WebPage', '@id': postHref },
    url: postHref,
    inLanguage: SITE.lang,
    keywords: post.data.tags.join(', '),
    articleSection: post.data.tags[0],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: '首页', item: siteUrl },
      {
        '@type': 'ListItem',
        position: 2,
        name: '全部文章',
        item: new URL('blog/', siteUrl).href,
      },
      { '@type': 'ListItem', position: 3, name: post.data.title, item: postHref },
    ],
  },
];
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  type="article"
  image={`/og/${post.id}.png`}
  jsonLd={jsonLd}
>
  {/* 阅读进度条：纯 CSS scroll-driven 动画驱动，零 JS（见 global.css 28.5）。
      放在最外层是为了让 fixed 定位不受 post-body 的 grid 影响。 */}
  <div class="reading-progress" aria-hidden="true"></div>

  <div class="wrap wrap--post">
    <article>
      <header class="post-hero">
        <h1 class="post-hero__title">{post.data.title}</h1>

        {post.data.description && <p class="post-hero__desc">{post.data.description}</p>}

        {
          post.data.tags.length > 0 && (
            <div class="post-hero__tags">
              {post.data.tags.map((tag) => (
                <a class="tag" href={tagUrl(tag)}>
                  {tag}
                </a>
              ))}
            </div>
          )
        }
      </header>

      <div class="post-body">
        <div class="prose">
          <Content />
        </div>

        {
          toc.length > 1 && (
            <nav class="toc" aria-label="本文目录">
              <p class="toc__label">目录</p>
              <ol>
                {toc.map((h) => (
                  <li class:list={h.depth === 3 && 'toc__lvl3'}>
                    <a href={`#${h.slug}`}>{h.text}</a>
                  </li>
                ))}
              </ol>
            </nav>
          )
        }
      </div>
    </article>

    <footer class="post-footer">
      <nav class="post-nav" aria-label="文章导航">
        {
          older ? (
            <a class="post-nav__link" href={postUrl(older.id)}>
              <span class="post-nav__label">更早一篇</span>
              <span class="post-nav__title">{older.data.title}</span>
            </a>
          ) : (
            <span class="post-nav__link post-nav__empty">
              <span class="post-nav__label">更早一篇</span>
              <span class="post-nav__title">没有更早的了</span>
            </span>
          )
        }

        {
          newer ? (
            <a class="post-nav__link post-nav__link--next" href={postUrl(newer.id)}>
              <span class="post-nav__label">更新一篇</span>
              <span class="post-nav__title">{newer.data.title}</span>
            </a>
          ) : (
            <span class="post-nav__link post-nav__link--next post-nav__empty">
              <span class="post-nav__label">更新一篇</span>
              <span class="post-nav__title">这是最新一篇</span>
            </span>
          )
        }
      </nav>
    </footer>
  </div>
</BaseLayout>

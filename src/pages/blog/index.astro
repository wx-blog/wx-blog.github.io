---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';
import { getPublishedPosts, groupByYear } from '../../utils/posts';

const posts = await getPublishedPosts();
const years = groupByYear(posts);
---

<BaseLayout title="全部文章" description="按时间倒序排列的全部文章。">
  <div class="wrap">
    <header class="page-hero">
      <p class="page-hero__eyebrow" data-reveal>ARCHIVE</p>
      <h1 class="page-hero__title" data-reveal style="--d:.05s">全部文章</h1>
      <p class="page-hero__lede" data-reveal style="--d:.12s">
        共 {posts.length} 篇，按发布时间倒序。也可以<a href="/tags/">按标签</a>浏览，或者订阅 <a href="/rss.xml">RSS</a>。
      </p>
    </header>

    {
      years.map(([year, items]) => (
        <section class="year-group">
          <h2 class="year-group__label" data-reveal>
            {year} · {items.length} 篇
          </h2>
          <PostList posts={items} />
        </section>
      ))
    }
  </div>
</BaseLayout>

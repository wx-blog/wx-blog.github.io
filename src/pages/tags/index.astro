---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { collectTags, getPublishedPosts, tagUrl } from '../../utils/posts';

const posts = await getPublishedPosts();
const tags = collectTags(posts);
---

<BaseLayout title="标签" description="按标签浏览全部文章。">
  <div class="wrap">
    <header class="page-hero">
      <p class="page-hero__eyebrow" data-reveal>TAGS</p>
      <h1 class="page-hero__title" data-reveal style="--d:.05s">标签</h1>
      <p class="page-hero__lede" data-reveal style="--d:.12s">
        共 {tags.length} 个标签，按文章数量排列。后面数字是篇数。
      </p>
    </header>

    {
      tags.length === 0 ? (
        <p class="empty">还没有标签。</p>
      ) : (
        <div class="tag-cloud tag-cloud--big" data-reveal style="--d:.18s">
          {tags.map(([tag, count]) => (
            <a class="tag" href={tagUrl(tag)}>
              {tag} · {count}
            </a>
          ))}
        </div>
      )
    }
  </div>
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
import { collectTags, getPublishedPosts, postUrl, tagUrl, readingTime } from '../utils/posts';

const posts = await getPublishedPosts();
const latest = posts.slice(0, 5);
const tags = collectTags(posts);
const totalMinutes = posts.reduce((sum, p) => sum + readingTime(p.body), 0);

/* 首屏展示的技术方向：取标签里排在前面的几个。
   为什么用标签而不是手写一份方向清单：
   手写清单需要跟实际文章永远保持同步——加了新方向忘了改这里，
   首屏就会出现点进去空空如也的死链。用标签则天然自洽：
   有文章才有标签，没文章的方向不会出现在首屏。
   上限 4 个，正好排满首屏底部的一行索引。 */
const topics = tags.slice(0, 4);

/* 首屏推荐：用学习路径里的第一篇，而不是"最新一篇"。
   32 篇文章的 pubDate 都是同一天，没有 pubTime 时谁排第一都是文件名顺序，
   标成"最新"是在编造事实。推荐一篇地基性质的文章反而更诚实。 */
const recommended =
  posts.find((p) => p.id === '2026-09-21-linux-permission-model') ?? posts[0];
---

<BaseLayout>
  <!--
    首屏：左对齐的两栏构图 + 底部索引。
    ------------------------------------------------------------
    参考的是一张 fintech 落地页：近黑底、细竖线、左侧超大标题、
    右侧短段与数据、底部紫色地平线和大弧线。
    这里只借它的**骨架**（对齐方式、层级、留白），不搬它的文案，
    也不使用任何与站内事实无关的数字。

    为什么从居中改成左对齐：
    居中构图只有一条中轴线，所有元素的起点相同，层级只能靠字号区分；
    左对齐把标题、正文、索引串成一条竖线，右侧留白给数据，
    视线从上到下只需要沿着一侧走，信息更容易被扫完。

    地平线弧线纯 CSS 绘制，放在 .hero 内部而不是全站背景：
    它属于首屏构图，带进列表页/文章页只会干扰阅读。
  -->
  <section class="hero">
    <div class="hero__inner">
      <div class="hero__main">
        <p class="hero__eyebrow" data-hero="1">
          <span class="pulse-dot" aria-hidden="true"></span>
          <span class="mono-label">LINUX / CLOUD / INFRA</span>
        </p>

        <h1 class="hero__title" data-hero="2">
          把踩过的坑，<br />写成<span class="grad-text">能复现</span>的笔记
        </h1>

        <p class="hero__lede" data-hero="3">
          实验记录、踩坑复盘，以及能直接贴进终端的命令。
        </p>

        {
          recommended && (
            <a class="hero__start" href={postUrl(recommended.id)} data-hero="4">
              <span class="hero__start-meta">
                <span class="mono-label">START HERE</span>
                <span class="hero__start-rule" aria-hidden="true" />
              </span>
              <span class="hero__start-title">{recommended.data.title}</span>
              <span class="hero__start-arrow" aria-hidden="true">
                ↗
              </span>
            </a>
          )
        }
      </div>

      <aside class="hero__aside" data-hero="5">
        <p class="hero__aside-label mono-label">// FIELD NOTES</p>
        <p class="hero__aside-text">
          Linux 与云计算方向的实验记录。命令都实际跑过，报错、取舍和最后怎么绕过去的，一并写清楚。
        </p>

        <div class="hero__stats">
          <div class="hero__stat">
            <span class="hero__stat-value">{posts.length}</span>
            <span class="hero__stat-label mono-label">ARTICLES</span>
          </div>
          <div class="hero__stat">
            <span class="hero__stat-value">{tags.length}</span>
            <span class="hero__stat-label mono-label">TOPICS</span>
          </div>
          <div class="hero__stat">
            <span class="hero__stat-value">{totalMinutes}</span>
            <span class="hero__stat-label mono-label">MIN READ</span>
          </div>
        </div>
      </aside>
    </div>

    <div class="hero__foot">
      {
        topics.length > 0 && (
          <nav class="hero__topic-list" aria-label="技术方向">
            {topics.map(([tag, count]) => (
              <a class="hero__topic" href={tagUrl(tag)}>
                <span class="hero__topic-name">{tag}</span>
                <span class="hero__topic-count">{String(count).padStart(2, '0')}</span>
              </a>
            ))}
          </nav>
        )
      }

      <a class="hero__scroll" href="#latest">
        <span class="mono-label">SCROLL</span>
        <span class="hero__scroll-arrow" aria-hidden="true">↓</span>
      </a>
    </div>

    <div class="hero__horizon" aria-hidden="true">
      <span class="hero__arc hero__arc--1"></span>
      <span class="hero__arc hero__arc--2"></span>
    </div>
  </section>

  <section class="section" id="latest">
    <div class="wrap">
      <div class="section__head section__head--row">
        <p class="section__eyebrow" data-reveal><span>01</span> / RECENT</p>
        <h2 class="section__title" data-reveal style="--d:.05s">最近整理的几篇</h2>
        <a class="section__more" href="/blog/">全部文章 ↗</a>
      </div>

      <PostList posts={latest} featureFirst />
    </div>
  </section>

  {
    tags.length > 0 && (
      <section class="section">
        <div class="wrap">
          <div class="section__head section__head--row">
            <p class="section__eyebrow" data-reveal>
              <span>02</span> / INDEX
            </p>
            <h2 class="section__title" data-reveal style="--d:.05s">
              按标签找
            </h2>
            <a class="section__more" href="/tags/">
              全部标签 ↗
            </a>
          </div>

          <div class="tag-cloud tag-cloud--big" data-reveal>
            {tags.slice(0, 16).map(([tag, count]) => (
              <a class="tag" href={tagUrl(tag)}>
                {tag} · {count}
              </a>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="outro">
    <div class="wrap">
      <div class="outro__box" data-reveal>
        <h2 class="outro__title">这些笔记值不值得读？</h2>
        <p class="outro__text">
          标准只有一条：照着做能复现。写下的每条命令我自己跑过，踩坑的地方会写明当时的报错和最后怎么绕过去的。
        </p>
        <div class="pill-group">
          <a class="btn btn--solid" href="/blog/">开始读 →</a>
          <a class="btn btn--ghost" href="/about/">关于这个站</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

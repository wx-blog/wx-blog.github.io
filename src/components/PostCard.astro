---
import type { Post } from '../utils/posts';
import { cardExcerpt, formatDate, postUrl, readingTime, tagUrl } from '../utils/posts';

interface Props {
  post: Post;
  /** 整行大卡片，用于首页首篇 */
  feature?: boolean;
  showTags?: boolean;
}

const { post, feature = false, showTags = true } = Astro.props;

const minutes = readingTime(post.body);
const href = postUrl(post.id);
---

<!--
  卡片 = 一块薄面板，标题直接排在面板里。
  ------------------------------------------------------------
  早先是「上半部程序化 SVG 封面图 / 下半部标题 + 描述」的两段式。
  封面图虽然每篇配色不同，但与内容无关，占掉卡片一半面积却不传递信息。

  现在的做法是让**标题本身成为封面**：卡片只有一条 1px 边框，
  背景比页面亮一点点，靠排版层级区分内容，不靠图案。
  上一版用的毛玻璃材质已撤掉——列表一屏有六到九张卡，
  每张都做一次 backdrop-filter 是纯开销，而平直面板在长列表里更安静。

  右上角原本还有一个 `// 编号` 角标（文章 ID 的哈希短码），
  已按用户要求去掉：它既不参与点击、也不承载信息。
-->
<article
  class:list={['card', feature && 'card--feature']}
  data-reveal
>
  <div class="card__head">
    <h3 class="card__title">
      <a href={href}>{post.data.title}</a>
    </h3>
  </div>

  <div class="card__body">
    {post.data.description && <p class="card__desc">{cardExcerpt(post.data.description)}</p>}

    <div class="card__meta">
      <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
      <span class="card__dot">·</span>
      <span>约 {minutes} 分钟</span>
      {
        post.data.updatedDate && (
          <>
            <span class="card__dot">·</span>
            <span>已修订</span>
          </>
        )
      }
    </div>

    {
      showTags && post.data.tags.length > 0 && (
        <div class="card__tags">
          {post.data.tags.map((tag) => (
            <a class="tag" href={tagUrl(tag)}>
              {tag}
            </a>
          ))}
        </div>
      )
    }
  </div>
</article>

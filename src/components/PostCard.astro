---
import type { Post } from '../utils/posts';
import { cardExcerpt, postUrl, tagUrl } from '../utils/posts';

interface Props {
  post: Post;
  /** 整行大卡片，用于首页首篇 */
  feature?: boolean;
  showTags?: boolean;
}

const { post, feature = false, showTags = true } = Astro.props;

const href = postUrl(post.id);
---

<!--
  卡片 = 一块薄面板，标题直接排在面板里。
  ------------------------------------------------------------
  早先是「上半部程序化 SVG 封面图 / 下半部标题 + 描述」的两段式。
  封面图虽然每篇配色不同，但与内容无关，占掉卡片一半面积却不传递信息。

  现在的做法是让**标题本身成为封面**：整张卡是一块带边框的毛玻璃，
  标题直接排在玻璃里，靠排版层级区分内容，不靠图案。
  列表一屏只露六到九张卡，模糊在滚动期间会自动摘掉
  （见 global.css §33.10），静止时才有完整的磨砂质感。

  右上角原本还有一个 `// 编号` 角标（文章 ID 的哈希短码），
  已按用户要求去掉：它既不参与点击、也不承载信息。
-->
<article
  class:list={['card', feature && 'card--feature']}
  data-reveal
>
  <div class="card__head">
    <h3 class="card__title">
      <a href={href}>{post.data.title}</a>
    </h3>
  </div>

  <div class="card__body">
    {post.data.description && <p class="card__desc">{cardExcerpt(post.data.description)}</p>}

    {
      showTags && post.data.tags.length > 0 && (
        <div class="card__tags">
          {post.data.tags.map((tag) => (
            <a class="tag" href={tagUrl(tag)}>
              {tag}
            </a>
          ))}
        </div>
      )
    }
  </div>
</article>

---
/**
 * 四角星标记。
 *
 * 参考的 AI 界面里，"星"是唯一一个不带文字的识别符号：
 * 它出现在页头、输入框和按钮上，看到形状就知道是谁。
 * 这里用一个渐变填充的 4 角星 + 一颗小的伴星，代替原来的 HUD 取景框。
 *
 * 渐变 id 每个实例必须唯一：同一个页面里页头和首屏各放一颗，
 * 若共用 id，第二颗会引用第一颗的渐变（浏览器只认文档里第一个定义），
 * 分开传 id 是最省事、也不依赖构建顺序的做法。
 */
interface Props {
  size?: number;
  id?: string;
  class?: string;
  /** 是否带右上角的小伴星 */
  sparkle?: boolean;
}

const { size = 20, id, class: className, sparkle = true } = Astro.props;
const uid = id ?? `spark-${Math.random().toString(36).slice(2, 8)}`;
---

<svg
  class:list={['spark', className]}
  width={size}
  height={size}
  viewBox="0 0 32 32"
  fill="none"
  aria-hidden="true"
>
  <defs>
    <linearGradient id={uid} x1="4" y1="2" x2="28" y2="30" gradientUnits="userSpaceOnUse">
      <stop offset="0" stop-color="#7db4ff"></stop>
      <stop offset="0.52" stop-color="#a78bfa"></stop>
      <stop offset="1" stop-color="#f0a6ca"></stop>
    </linearGradient>
  </defs>

  <path
    d="M14 4.6c.68 7.2 4.14 10.66 11.34 11.34.8.08.8 1.32 0 1.4C18.14 18.02 14.68 21.48 14 28.68c-.08.8-1.32.8-1.4 0-.68-7.2-4.14-10.66-11.34-11.34-.8-.08-.8-1.32 0-1.4C8.46 15.26 11.92 11.8 12.6 4.6c.08-.8 1.32-.8 1.4 0Z"
    fill={`url(#${uid})`}></path>

  {
    sparkle && (
      <path
        d="M25.4 1.8c.28 2.98 1.94 4.64 4.92 4.92.34.03.34.53 0 .56-2.98.28-4.64 1.94-4.92 4.92-.03.34-.53.34-.56 0-.28-2.98-1.94-4.64-4.92-4.92-.34-.03-.34-.53 0-.56 2.98-.28 4.64-1.94 4.92-4.92.03-.34.53-.34.56 0Z"
        fill={`url(#${uid})`}
        opacity="0.82"></path>
    )
  }
</svg>

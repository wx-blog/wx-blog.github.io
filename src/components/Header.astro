---
import { SITE } from '../consts';

const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="site-header">
  <div class="wrap site-header__inner">
    <a class="brand" href="/">
      {/* HUD 取景框式标记：四角 + 中心点，比实心方块更像仪器界面 */}
      <svg class="brand__glyph" width="18" height="18" viewBox="0 0 18 18" aria-hidden="true">
        <path
          d="M2 6V3.5A1.5 1.5 0 0 1 3.5 2H6M12 2h2.5A1.5 1.5 0 0 1 16 3.5V6M16 12v2.5a1.5 1.5 0 0 1-1.5 1.5H12M6 16H3.5A1.5 1.5 0 0 1 2 14.5V12"
          fill="none"
          stroke="currentColor"
          stroke-width="1.3"></path>
        <circle cx="9" cy="9" r="1.5" fill="currentColor"></circle>
      </svg>
      <span>{SITE.title}</span>
    </a>

    <nav class="site-nav" aria-label="主导航">
      {
        SITE.nav.map((item) => (
          <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
      {/* 搜索是站内页面而不是弹层，所以这里用普通链接，
          不标注键盘快捷键——页面上并没有对应的快捷键实现。 */}
      <a class="nav-search" href="/search/" aria-label="搜索文章">
        <svg width="14" height="14" viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="1.8" />
          <path d="m15.5 15.5 4.5 4.5" fill="none" stroke="currentColor" stroke-width="1.8" />
        </svg>
        <span class="nav-search__label">搜索</span>
      </a>
      {/* ThemeToggle 已移除：本站只做暗色，不需要切换入口。
          主题在 BaseLayout 的 is:inline 脚本里锁成 dark。 */}
    </nav>
  </div>
</header>

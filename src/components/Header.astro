---
import { SITE } from '../consts';
import Spark from './Spark.astro';

const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="site-header">
  <div class="wrap site-header__inner">
    <a class="brand" href="/">
      {/* 渐变四角星：页头、首屏、搜索框共用同一个符号，替代原来的 HUD 取景框 */}
      <Spark class="brand__glyph" size={20} id="spark-brand" />
      <span>{SITE.title}</span>
    </a>

    <nav class="site-nav" aria-label="主导航">
      {
        SITE.nav.map((item) => (
          <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
      {/* 搜索是站内页面而不是弹层；首页和搜索页支持按 / 聚焦输入框。 */}
      <a class="nav-search" href="/search/" aria-label="搜索文章">
        <svg width="14" height="14" viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="1.8" />
          <path d="m15.5 15.5 4.5 4.5" fill="none" stroke="currentColor" stroke-width="1.8" />
        </svg>
        <span class="nav-search__label">搜索</span>
      </a>
      {/* ThemeToggle 已移除：本站只做暗色，不需要切换入口。
          主题在 BaseLayout 的 is:inline 脚本里锁成 dark。 */}
    </nav>
  </div>
</header>

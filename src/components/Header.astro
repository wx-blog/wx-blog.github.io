---
import { SITE } from '../consts';

const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="site-header">
  <div class="wrap site-header__inner">
    <a class="brand" href="/">
      <svg class="brand__glyph" width="18" height="18" viewBox="0 0 18 18" aria-hidden="true">
        <rect
          x="1"
          y="1"
          width="16"
          height="16"
          rx="5"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          opacity="0.3"></rect>
        <rect x="6" y="6" width="6" height="6" rx="2" fill="currentColor"></rect>
      </svg>
      <span>{SITE.title}</span>
    </a>

    <nav class="site-nav" aria-label="主导航">
      {
        SITE.nav.map((item) => (
          <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
      {/* ThemeToggle 已移除：本站只做暗色，不需要切换入口。
          主题在 BaseLayout 的 is:inline 脚本里锁成 dark。 */}
    </nav>
  </div>
</header>

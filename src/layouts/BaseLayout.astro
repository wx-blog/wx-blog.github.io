---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Backdrop from '../components/Backdrop.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../consts';

interface Props {
  /** 页面标题，会拼在站点名前面 */
  title?: string;
  description?: string;
  /** og:type */
  type?: 'website' | 'article';
}

const { title, description = SITE.description, type = 'website' } = Astro.props;

const pageTitle = title ? `${title} · ${SITE.title}` : `${SITE.title} · ${SITE.tagline}`;
const siteUrl = Astro.site?.href ?? SITE.url;
const canonical = new URL(Astro.url.pathname, siteUrl).href;
const rssHref = new URL('rss.xml', siteUrl).href;
const ogImage = new URL('og-default.png', siteUrl).href;
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href={rssHref} />
    <meta name="author" content={SITE.author} />

    {/* 自托管字体子集，提前拉取，避免中文标题先以回退字体渲染再跳一下 */}
    <link rel="preload" as="font" type="font/woff2" href="/fonts/noto-sans-sc.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/inter-latin.woff2" crossorigin />

    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />

    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="zh_CN" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />

    <ClientRouter />

    {/* 主题：本站**只做暗色**，不做亮色主题。
        ------------------------------------------------------------
        原先的逻辑是「读 localStorage → 没有就跟系统偏好」，
        并且支持亮/暗切换。现在直接锁成 dark：

        · 不读 localStorage —— 免得老访客的 'light' 存储值
          把页面拉回已经不再维护的亮色样式（那套配色的
          对比度是按旧的亮色场景调的，现在没有场景了）。
        · 不看系统偏好 —— 用户在浅色系统的浏览器里打开，
          看到的也应该是暗色。
        · 顺手把可能残留的 localStorage 清掉，
          避免以后万一恢复双主题时被旧的脏值干扰。

        仍然放在 is:inline 且在所有样式之前执行，
        否则会出现"先亮一下再变暗"的闪烁。 */}
    <script is:inline>
      (() => {
        document.documentElement.dataset.theme = 'dark';
        try {
          localStorage.removeItem('theme');
        } catch {
          /* 隐私模式下 localStorage 可能不可用，忽略即可 */
        }
        // 标记 JS 可用：滚动进入动效只在有 JS 时才隐藏元素
        document.documentElement.classList.add('js');

        /* 首屏入场（从远到近）：在这里挂"初始态"类，而不是在页面底部。
           ------------------------------------------------------------
           ⚠️ **必须放在 head、必须早于样式生效**，否则会闪一下：
           如果等 body 底部再挂，浏览器已经按"最终态"渲染过一帧了，
           然后类一挂又跳回"远处"再推近——用户会看到文字先到眼前、
           再缩回去、再推过来，比不做动画还糟。

           放在 head 的这段脚本执行时，DOM 里还没有 body 内容，
           样式也还没应用到 .hero 上，所以"从远处开始"是第一帧就成立的。

           ⚠️ 减少动态效果时**直接不加类**（元素停在 CSS 默认的最终态），
           而不是"把时长调成 0"——后者仍会走一遍过渡管线。

           只有首页有 .hero，但这里不做判断：类挂在 <html> 上，
           没有 .hero 的页面自然匹配不到任何规则，零成本。 */
        if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          document.documentElement.classList.add('is-entering');
          // 首帧之后再移除 —— 浏览器需要先认下初始态，过渡才会播
          requestAnimationFrame(() => {
            requestAnimationFrame(() => {
              document.documentElement.classList.remove('is-entering');
            });
          });
        }
      })();
    </script>
  </head>

  <body>
    <Backdrop />

    <a class="skip-link" href="#main">跳到正文</a>

    <Header />

    <main id="main">
      <slot />
    </main>

    <Footer />

    {/* 页头细线 / 滚动进入 / 目录高亮。挂在 window 上，避免视图过渡时重复绑定。 */}
    <script is:inline>
      (() => {
        if (!window.__zx) {
          const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          let io = null;
          let ticking = false;

          const spy = () => {
            const links = document.querySelectorAll('.toc a[href^="#"]');
            if (!links.length) return;
            let activeId = '';
            for (const a of links) {
              const el = document.getElementById(decodeURIComponent(a.hash.slice(1)));
              if (el && el.getBoundingClientRect().top <= 130) {
                activeId = decodeURIComponent(a.hash.slice(1));
              }
            }
            for (const a of links) {
              a.classList.toggle('is-active', decodeURIComponent(a.hash.slice(1)) === activeId);
            }
          };

          const onScroll = () => {
            if (ticking) return;
            ticking = true;
            requestAnimationFrame(() => {
              ticking = false;
              const header = document.querySelector('.site-header');
              if (header) header.classList.toggle('is-scrolled', window.scrollY > 8);
              spy();
            });
          };

          const setup = () => {
            onScroll();
            if (reduce) {
              for (const el of document.querySelectorAll('[data-reveal]')) el.classList.add('is-in');
              return;
            }
            if (!io) {
              io = new IntersectionObserver(
                (entries) => {
                  for (const entry of entries) {
                    if (entry.isIntersecting) {
                      entry.target.classList.add('is-in');
                      io.unobserve(entry.target);
                    }
                  }
                },
                { rootMargin: '0px 0px -6% 0px', threshold: 0.04 },
              );
            }
            document.querySelectorAll('[data-reveal]:not(.is-in)').forEach((el, i) => {
              // 同屏的卡片错开一点点入场，顺序感来自这里
              el.style.setProperty('--d', `${Math.min(i % 4, 3) * 0.07}s`);
              io.observe(el);
            });
          };

          window.addEventListener('scroll', onScroll, { passive: true });

          /**
           * 给正文里每个代码块装上工具条：语言标签 + 复制按钮。
           *
           * 为什么不在 Markdown/Astro 层面生成：
           * Shiki 输出的是纯 <pre><code>，要在构建期插 DOM 得改整个渲染管线，
           * 成本高且脆弱。运行时挂载只要几十行，还能天然兼容视图过渡
           * （astro:page-load 会在每次换页后重跑）。
           *
           * 语言名从 Shiki 写在 <pre> 上的 data-language 取，不再猜。
           */
          const enhanceCode = () => {
            const blocks = document.querySelectorAll('.prose pre');
            for (const pre of blocks) {
              if (pre.dataset.enhanced === '1') continue;
              pre.dataset.enhanced = '1';

              // Shiki 用 data-language 标了语言；没有就不显示标签
              const lang = pre.getAttribute('data-language') || '';
              const shell = document.createElement('div');
              shell.className = 'code-shell';

              const bar = document.createElement('div');
              bar.className = 'code-bar';

              const label = document.createElement('span');
              label.className = 'code-bar__lang';
              label.textContent = lang || 'text';
              bar.appendChild(label);

              const btn = document.createElement('button');
              btn.type = 'button';
              btn.className = 'code-bar__copy';
              btn.textContent = '复制';
              btn.setAttribute('aria-label', '复制这段代码');
              bar.appendChild(btn);

              // 把 pre 包进容器，工具条就能贴着它定位
              pre.parentNode.insertBefore(shell, pre);
              shell.appendChild(bar);
              shell.appendChild(pre);

              btn.addEventListener('click', async () => {
                const code = pre.querySelector('code');
                const text = code ? code.innerText : pre.innerText;
                try {
                  await navigator.clipboard.writeText(text);
                  btn.textContent = '已复制';
                  btn.classList.add('is-done');
                } catch {
                  // 非安全上下文或用户拒绝授权时的兜底
                  btn.textContent = '复制失败';
                }
                setTimeout(() => {
                  btn.textContent = '复制';
                  btn.classList.remove('is-done');
                }, 1600);
              });
            }
          };

          window.__zx = { setup, enhanceCode };
          document.addEventListener('astro:page-load', () => {
            setup();
            enhanceCode();
          });
        }
        window.__zx.setup();
        window.__zx.enhanceCode();
      })();
    </script>
  </body>
</html>

---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Backdrop from '../components/Backdrop.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Intro from '../components/Intro.astro';
import { SITE } from '../consts';

interface Props {
  /** 页面标题，会拼在站点名前面 */
  title?: string;
  description?: string;
  /** og:type */
  type?: 'website' | 'article';
  /** 自定义分享图，传站内路径，如 /og/xxx.png；不传则用默认图 */
  image?: string;
  /** 不参与搜索引擎索引（404 等） */
  noindex?: boolean;
  /** 页面级结构化数据；不传则输出站点级 WebSite */
  jsonLd?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const {
  title,
  description = SITE.description,
  type = 'website',
  image,
  noindex = false,
  jsonLd,
} = Astro.props;

const pageTitle = title ? `${title} · ${SITE.title}` : `${SITE.title} · ${SITE.tagline}`;
const siteUrl = Astro.site?.href ?? SITE.url;
const canonical = new URL(Astro.url.pathname, siteUrl).href;
const rssHref = new URL('rss.xml', siteUrl).href;
const ogImage = new URL(image ?? 'og-default.png', siteUrl).href;

/* 站点级结构化数据：告诉搜索引擎「这是一个网站」，
   并声明站内搜索的入口模板（对应 /search/?q=...）。 */
const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.title,
  alternateName: SITE.author,
  url: siteUrl,
  description: SITE.description,
  inLanguage: SITE.lang,
  potentialAction: {
    '@type': 'SearchAction',
    target: {
      '@type': 'EntryPoint',
      urlTemplate: `${new URL('search/', siteUrl).href}?q={search_term_string}`,
    },
    'query-input': 'required name=search_term_string',
  },
};

/* JSON 里的 `<` 一律转成 \u003c，避免正文里出现 </script> 把标签提前闭合 */
const jsonLdText = JSON.stringify(jsonLd ?? websiteJsonLd).replace(/</g, '\\u003c');
---

<!doctype html>
<!--
  主题直接写在 <html> 上，不等 JS。
  ------------------------------------------------------------
  早先只靠 head 里的脚本添加 `data-theme`，有两个问题：

  ① **首屏要等脚本执行才有主题**，样式应用与脚本执行之间的缝隙里
     会闪一下亮色（这也是当初"先亮一下再变暗"的成因）；
  ② 站点用了 ClientRouter，站内跳转是 SPA 式替换 body。
     属性一旦没被保住，`:root[data-theme='dark']` 立刻失效，
     页面退回亮色 —— 这就是用户说的「点进文档再返回来，
     就变成了白天模式」。

  写成静态属性后，服务端渲染出来的 HTML 本身就带主题，两个问题一起解决。
  （CSS 那边也做了对应改动：暗色变量已经从 `:root[data-theme='dark']`
    搬到 `:root`，不再依赖这个属性。两层保险。） -->
<html lang={SITE.lang} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href={rssHref} />
    <meta name="author" content={SITE.author} />

    {/* 自托管字体子集，提前拉取，避免中文标题先以回退字体渲染再跳一下 */}
    <link rel="preload" as="font" type="font/woff2" href="/fonts/noto-sans-sc.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/inter-latin.woff2" crossorigin />

    {/* 浏览器 UI 配色（移动端状态栏 / 桌面地址栏）：
        站点只有暗色，所以不再按系统偏好给两个值 —— 直接锁成
        站点底色 #050509（与 --bg 一致）。
        原来那条 `prefers-color-scheme: light` 会让浅色系统的用户
        看到一条白色状态栏压在深色页面上，很突兀。 */}
    <meta name="theme-color" content="#050509" />

    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={pageTitle} />
    <meta property="og:locale" content="zh_CN" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={jsonLdText} />

    <ClientRouter />

    {/* 主题：本站**只做暗色**，不做亮色主题。
        ------------------------------------------------------------
        原先的逻辑是「读 localStorage → 没有就跟系统偏好」，
        并且支持亮/暗切换。现在直接锁成 dark：

        · 不读 localStorage —— 免得老访客的 'light' 存储值
          把页面拉回已经不再维护的亮色样式（那套配色的
          对比度是按旧的亮色场景调的，现在没有场景了）。
        · 不看系统偏好 —— 用户在浅色系统的浏览器里打开，
          看到的也应该是暗色。
        · 顺手把可能残留的 localStorage 清掉，
          避免以后万一恢复双主题时被旧的脏值干扰。

        仍然放在 is:inline 且在所有样式之前执行，
        否则会出现"先亮一下再变暗"的闪烁。 */}
    <script is:inline>
      (() => {
        document.documentElement.dataset.theme = 'dark';
        try {
          localStorage.removeItem('theme');
        } catch {
          /* 隐私模式下 localStorage 可能不可用，忽略即可 */
        }
        // 标记 JS 可用：滚动进入动效只在有 JS 时才隐藏元素
        document.documentElement.classList.add('js');

        /* 首屏入场（从远到近）：在这里挂"初始态"类，而不是在页面底部。
           ------------------------------------------------------------
           ⚠️ **必须放在 head、必须早于样式生效**，否则会闪一下：
           如果等 body 底部再挂，浏览器已经按"最终态"渲染过一帧了，
           然后类一挂又跳回"远处"再推近——用户会看到文字先到眼前、
           再缩回去、再推过来，比不做动画还糟。

           放在 head 的这段脚本执行时，DOM 里还没有 body 内容，
           样式也还没应用到 .hero 上，所以"从远处开始"是第一帧就成立的。

           ⚠️ 减少动态效果时**直接不加类**（元素停在 CSS 默认的最终态），
           而不是"把时长调成 0"——后者仍会走一遍过渡管线。

           只有首页有 .hero，但这里不做判断：类挂在 <html> 上，
           没有 .hero 的页面自然匹配不到任何规则，零成本。 */
        const root = document.documentElement;
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        /* 开场层只在**首次进入首页**时出现。
           ------------------------------------------------------------
           判断放在 head 里，和 is-entering 一起、早于首帧，原因同上：
           等 DOMContentLoaded 再决定，用户会先看见内容、再被盖住。

           三个约束：
             · 只认首页。从搜索结果直接落进某篇文章的人要的是内容，
               不是先看两秒片头；
             · 同一标签页只播一次（sessionStorage）。刷新不重播，
               新开标签页仍会播——那才是"打开网站"的语义；
             · ?intro=1 强制播放、?intro=0 强制跳过，方便预览和分享。
           减少动态效果优先级最高：开着它时一律不播。 */
        const query = new URLSearchParams(location.search);
        const force = query.get('intro');
        let seen = false;
        try {
          seen = sessionStorage.getItem('wx-intro') === '1';
        } catch {
          /* 隐私模式可能禁用 sessionStorage，按"没看过"处理 */
        }
        const showIntro =
          !reduce &&
          (force === '1' ||
            (force !== '0' && location.pathname === '/' && !location.hash && !seen));

        /* 开场期间拦一下滚轮 / 触摸滚动。
           为什么不直接给 <html> 加 overflow:hidden：
           那样滚动条会消失，布局横向跳 15px，片头结束时再跳回来。
           这里只拦事件，不动布局。任何滚动尝试都顺手当作"跳过"，
           因为能滚说明用户想往下看，不该继续等片头。 */
        let releaseScroll = () => {};
        if (showIntro) {
          const block = (event) => {
            if (event.cancelable) event.preventDefault();
            window.__introSkip?.();
          };
          window.addEventListener('wheel', block, { passive: false });
          window.addEventListener('touchmove', block, { passive: false });
          releaseScroll = () => {
            window.removeEventListener('wheel', block);
            window.removeEventListener('touchmove', block);
          };
        }

        /* 收尾的唯一出口：片头脚本、跳过、兜底超时都走这里。
           必须先定义再挂超时，否则脚本抛错时页面永远停在片头上。 */
        window.__introTeardown = () => {
          root.classList.remove('is-intro', 'is-entering');
          const el = document.getElementById('intro');
          if (el) {
            el.hidden = true;
            el.classList.remove('is-out');
          }
          releaseScroll();
        };

        if (!reduce) {
          if (showIntro) {
            root.classList.add('is-intro', 'is-entering');
            // 时间线从"片头开始可见"算起，而不是从底部脚本执行算起
            window.__introAt = performance.now();
            try {
              sessionStorage.setItem('wx-intro', '1');
            } catch {
              /* 忽略：存不下就每次都播，功能不受影响 */
            }
            // 兜底：底部脚本被其他错误打断时，6 秒后强制揭幕
            window.setTimeout(() => window.__introTeardown(), 6000);
          } else {
            root.classList.add('is-entering');
            // 首帧之后再移除 —— 浏览器需要先认下初始态，过渡才会播
            requestAnimationFrame(() => {
              requestAnimationFrame(() => {
                root.classList.remove('is-entering');
              });
            });
          }
        }
      })();
    </script>
  </head>

  <body>
    {/* 站内换页时的顶部进度条。纯装饰，不承担导航状态说明。 */}
    <div class="route-progress" id="route-progress" aria-hidden="true"></div>

    {/* 站内换页时盖住旧页面的一层薄幕。
        ClientRouter 是"先换 DOM、再画新页"，中间会有一帧半旧半新的
        layout 跳动；这一层用极短的淡入把那一帧盖掉。
        没有 SPA 导航时它始终 visibility:hidden，不占任何东西。 */}
    <div class="page-veil" id="page-veil" aria-hidden="true"></div>

    <Intro />

    <Backdrop />

    <a class="skip-link" href="#main">跳到正文</a>

    <Header />

    <main id="main">
      <slot />
    </main>

    <Footer />

    {/* 开场层退场。
        ------------------------------------------------------------
        这里只做三件事：算还要等多久、把 .is-out 挂上、在淡出结束后
        调用 head 里定义好的 __introTeardown。
        所有"状态收尾"都集中在 __introTeardown 一处，避免 head 的兜底
        超时和这里的正常退出各收一半、留下半截类名。 */}
    <script is:inline>
      (() => {
        if (!document.documentElement.classList.contains('is-intro')) return;

        const intro = document.getElementById('intro');
        if (!intro) {
          window.__introTeardown?.();
          return;
        }

        const started = window.__introAt || performance.now();
        let finished = false;
        let timer = 0;

        const unbind = () => {
          window.removeEventListener('pointerdown', skip, true);
          window.removeEventListener('keydown', skip, true);
          window.removeEventListener('touchstart', skip, true);
        };

        const finish = (skipped) => {
          if (finished) return;
          finished = true;
          clearTimeout(timer);
          unbind();
          intro.classList.add('is-out');
          // 幕布开始淡出的同时放首屏进来，两层交叉，中间不会露出一块空黑
          document.documentElement.classList.remove('is-entering');
          // 数字滚动等页内动效挂在这条事件上：幕布还盖着的时候先别跑，
          // 否则揭开时数字早就停住了，白做一次动画。
          // __introDone 必须早于事件设置：事件是同步派发的，
          // 监听器里会立刻检查这个标记。
          window.__introDone = true;
          window.dispatchEvent(new Event('site:intro-done'));
          // 正常退场要等 80ms 延迟 + 700ms 淡出全部走完；跳过则缩短到 380ms
          window.setTimeout(() => window.__introTeardown?.(), skipped ? 380 : 800);
        };

        // 键鼠 / 触摸任意一处都算跳过；prompt 里不写"点击跳过"，
        // 只在右下角放一个很淡的提示，不打断中间那组字。
        const skip = () => finish(true);
        window.__introSkip = skip;

        window.addEventListener('pointerdown', skip, true);
        window.addEventListener('keydown', skip, true);
        window.addEventListener('touchstart', skip, true);

        /* 1200ms 是内容入场 + 进度线走完的时间；再留 250ms 让人看清
           最后一眼，然后开始退场。计时锚点是 head 里的 __introAt，
           所以即使底部脚本因为解析慢晚执行，总时长也不会被拉长。 */
        const wait = Math.max(0, 1450 - (performance.now() - started));
        timer = window.setTimeout(() => finish(false), wait);
      })();
    </script>

    {/* 订阅页的复制按钮 + 站内搜索。
        放在 BaseLayout 里而不是各自页面内：站点用了 ClientRouter，
        从页脚点进 /subscribe/ 或 /search/ 时页面脚本不一定会重新执行，
        但这里的监听挂在 document 与 astro:page-load 上，换页后依然有效。 */}
    <script is:inline>
      (() => {
        if (window.__siteTools) return;
        window.__siteTools = true;

        /* ---------- 订阅页：复制订阅地址 ---------- */
        document.addEventListener('click', async (event) => {
          const target = event.target instanceof Element ? event.target : null;
          const btn = target?.closest('[data-copy-feed]');
          if (!btn) return;

          const url = btn.getAttribute('data-copy-feed') || '';
          const original = btn.textContent;
          try {
            await navigator.clipboard.writeText(url);
            btn.textContent = '已复制';
            btn.dataset.copied = 'true';
          } catch {
            // 非安全上下文或拒绝授权：选中地址，让用户自己复制
            const code = btn.parentElement?.querySelector('.feed-box__url');
            if (code) {
              const range = document.createRange();
              range.selectNodeContents(code);
              const selection = window.getSelection();
              selection?.removeAllRanges();
              selection?.addRange(range);
            }
            btn.textContent = '请手动复制';
          }

          setTimeout(() => {
            btn.textContent = original;
            delete btn.dataset.copied;
          }, 1800);
        });

        /* ---------- 站内搜索 ---------- */
        let docs = null;
        let loading = null;

        const loadIndex = async () => {
          if (docs) return docs;
          if (!loading) {
            loading = fetch('/search-index.json')
              .then((res) => {
                if (!res.ok) throw new Error(String(res.status));
                return res.json();
              })
              .then((data) => {
                docs = data;
                return data;
              })
              .catch((err) => {
                loading = null;
                throw err;
              });
          }
          return loading;
        };

        const esc = (value) =>
          String(value).replace(
            /[&<>"']/g,
            (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c],
          );

        /* 先按纯文本切段、再分别转义，避免把插入的 <mark> 标签二次转义，
           也避免关键词命中 HTML 实体（如 amp）时标错位置。 */
        const mark = (text, terms) => {
          const source = String(text || '');
          const parts = terms
            .filter(Boolean)
            .map((t) => t.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'))
            .sort((a, b) => b.length - a.length);
          if (!source) return '';
          if (!parts.length) return esc(source);

          const re = new RegExp(parts.join('|'), 'gi');
          let out = '';
          let last = 0;
          let m;
          while ((m = re.exec(source)) !== null) {
            out += esc(source.slice(last, m.index));
            out += '<mark>' + esc(m[0]) + '</mark>';
            last = m.index + m[0].length;
            if (m.index === re.lastIndex) re.lastIndex += 1;
          }
          return out + esc(source.slice(last));
        };

        const render = (items, terms) => {
          const list = document.getElementById('search-results');
          const status = document.getElementById('search-status');
          if (!list || !status) return;

          if (!terms.length) {
            list.innerHTML = '';
            status.textContent = '';
            return;
          }
          if (!items.length) {
            list.innerHTML = '';
            status.textContent = `没有找到与「${terms.join(' ')}」匹配的文章。`;
            return;
          }

          status.textContent = `找到 ${items.length} 篇文章，按相关度排序。`;
          list.innerHTML = items
            .map(
              (doc) => `
              <li class="search-result">
                <a href="${esc(doc.url)}">
                  <div class="search-result__title">${mark(doc.title, terms)}</div>
                  <p class="search-result__desc">${mark(doc.description, terms)}</p>
                  <p class="search-result__meta">${esc(doc.date)} · ${esc(doc.tags.join(' / '))} · 约 ${doc.minutes} 分钟</p>
                </a>
              </li>`,
            )
            .join('');
        };

        const runSearch = (query) => {
          const raw = query.trim().split(/\s+/).filter(Boolean).slice(0, 8);
          if (!raw.length) {
            render([], []);
            return;
          }

          const terms = raw.map((t) => t.toLowerCase());
          const scored = [];

          for (const doc of docs) {
            const title = doc.title.toLowerCase();
            const desc = (doc.description || '').toLowerCase();
            const tags = doc.tags.join(' ').toLowerCase();
            const body = doc.text.toLowerCase();

            let score = 0;
            let hitAll = true;

            for (const term of terms) {
              let s = 0;
              if (title.includes(term)) s += 14;
              if (tags.includes(term)) s += 8;
              if (desc.includes(term)) s += 5;
              if (body.includes(term)) s += 2;
              if (!s) {
                hitAll = false;
                break;
              }
              score += s;
            }

            if (hitAll) scored.push({ doc, score });
          }

          scored.sort((a, b) => b.score - a.score);
          render(
            scored.slice(0, 30).map((item) => item.doc),
            raw,
          );
        };

        const update = async () => {
          const input = document.getElementById('search-input');
          const status = document.getElementById('search-status');
          if (!input) return;

          const q = input.value.trim();
          const url = new URL(location.href);
          if (q) url.searchParams.set('q', q);
          else url.searchParams.delete('q');
          history.replaceState(null, '', url);

          if (!q) {
            render([], []);
            return;
          }

          if (status) status.textContent = '搜索中…';
          try {
            await loadIndex();
            runSearch(q);
          } catch {
            if (status) status.textContent = '搜索索引加载失败，请刷新页面再试。';
          }
        };

        const initSearch = () => {
          const input = document.getElementById('search-input');
          if (!input || input.dataset.bound === '1') return;
          input.dataset.bound = '1';

          let timer = 0;
          input.addEventListener('input', () => {
            clearTimeout(timer);
            timer = setTimeout(update, 120);
          });
          input.addEventListener('keydown', (event) => {
            if (event.key === 'Escape') {
              event.preventDefault();
              input.value = '';
              update();
            }
          });

          const initial = new URL(location.href).searchParams.get('q');
          if (initial) {
            input.value = initial;
            update();
          }
        };

        // 搜索页按 / 聚焦输入框（其他页面没有搜索框，按了不做事）
        document.addEventListener('keydown', (event) => {
          if (event.key !== '/' || event.metaKey || event.ctrlKey || event.altKey) return;
          const active = document.activeElement;
          if (
            active &&
            (active.tagName === 'INPUT' || active.tagName === 'TEXTAREA' || active.isContentEditable)
          ) {
            return;
          }
          const input =
            document.getElementById('search-input') ??
            document.querySelector('[data-search-input]');
          if (!input) return;
          event.preventDefault();
          input.focus();
        });

        document.addEventListener('astro:page-load', initSearch);
        if (document.readyState !== 'loading') initSearch();
      })();
    </script>

    {/* 页头细线 / 滚动进入 / 目录高亮。挂在 window 上，避免视图过渡时重复绑定。 */}
    <script is:inline>
      (() => {
        if (!window.__zx) {
          const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          let io = null;
          let ticking = false;

          const spy = () => {
            const links = document.querySelectorAll('.toc a[href^="#"]');
            if (!links.length) return;
            let activeId = '';
            for (const a of links) {
              const el = document.getElementById(decodeURIComponent(a.hash.slice(1)));
              if (el && el.getBoundingClientRect().top <= 130) {
                activeId = decodeURIComponent(a.hash.slice(1));
              }
            }
            for (const a of links) {
              a.classList.toggle('is-active', decodeURIComponent(a.hash.slice(1)) === activeId);
            }
          };

          const onScroll = () => {
            if (ticking) return;
            ticking = true;
            requestAnimationFrame(() => {
              ticking = false;
              const header = document.querySelector('.site-header');
              if (header) header.classList.toggle('is-scrolled', window.scrollY > 8);
              spy();
            });
          };

          const setup = () => {
            onScroll();
            if (reduce) {
              for (const el of document.querySelectorAll('[data-reveal]')) el.classList.add('is-in');
              return;
            }
            if (!io) {
              io = new IntersectionObserver(
                (entries) => {
                  for (const entry of entries) {
                    if (entry.isIntersecting) {
                      entry.target.classList.add('is-in');
                      io.unobserve(entry.target);
                    }
                  }
                },
                { rootMargin: '0px 0px -6% 0px', threshold: 0.04 },
              );
            }
            document.querySelectorAll('[data-reveal]:not(.is-in)').forEach((el, i) => {
              // 同屏的卡片错开一点点入场，顺序感来自这里
              el.style.setProperty('--d', `${Math.min(i % 4, 3) * 0.07}s`);
              io.observe(el);
            });
          };

          window.addEventListener('scroll', onScroll, { passive: true });

          /**
           * 给正文里每个代码块装上工具条：语言标签 + 复制按钮。
           *
           * 为什么不在 Markdown/Astro 层面生成：
           * Shiki 输出的是纯 <pre><code>，要在构建期插 DOM 得改整个渲染管线，
           * 成本高且脆弱。运行时挂载只要几十行，还能天然兼容视图过渡
           * （astro:page-load 会在每次换页后重跑）。
           *
           * 语言名从 Shiki 写在 <pre> 上的 data-language 取，不再猜。
           */
          const enhanceCode = () => {
            const blocks = document.querySelectorAll('.prose pre');
            for (const pre of blocks) {
              if (pre.dataset.enhanced === '1') continue;
              pre.dataset.enhanced = '1';

              // Shiki 用 data-language 标了语言；没有就不显示标签
              const lang = pre.getAttribute('data-language') || '';
              const shell = document.createElement('div');
              shell.className = 'code-shell';

              const bar = document.createElement('div');
              bar.className = 'code-bar';

              const label = document.createElement('span');
              label.className = 'code-bar__lang';
              label.textContent = lang || 'text';
              bar.appendChild(label);

              const btn = document.createElement('button');
              btn.type = 'button';
              btn.className = 'code-bar__copy';
              btn.textContent = '复制';
              btn.setAttribute('aria-label', '复制这段代码');
              bar.appendChild(btn);

              // 把 pre 包进容器，工具条就能贴着它定位
              pre.parentNode.insertBefore(shell, pre);
              shell.appendChild(bar);
              shell.appendChild(pre);

              btn.addEventListener('click', async () => {
                const code = pre.querySelector('code');
                const text = code ? code.innerText : pre.innerText;
                try {
                  await navigator.clipboard.writeText(text);
                  btn.textContent = '已复制';
                  btn.classList.add('is-done');
                } catch {
                  // 非安全上下文或用户拒绝授权时的兜底
                  btn.textContent = '复制失败';
                }
                setTimeout(() => {
                  btn.textContent = '复制';
                  btn.classList.remove('is-done');
                }, 1600);
              });
            }
          };

          window.__zx = { setup, enhanceCode };
          document.addEventListener('astro:page-load', () => {
            setup();
            enhanceCode();
          });
        }
        window.__zx.setup();
        window.__zx.enhanceCode();
      })();
    </script>

    {/* 站内进度条 + 三个轻量交互：数字滚动、首屏光标光斑、卡片聚光。
        全部只改 transform / 自定义属性，减少动态效果时直接不绑定。 */}
    <script is:inline>
      (() => {
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        /* ---------- 顶部进度条：ClientRouter 开始加载 → 换页结束 ----------
           每次换页都会换掉整份 DOM，闭包里缓存的那个 div 已经不在文档里，
           所以这里始终按 id 现查，并在 after-swap 把状态交给新的节点。 */
        const barEl = () => document.getElementById('route-progress');
        let failsafe = 0;
        const resetBar = () => {
          const el = barEl();
          if (el) el.className = 'route-progress';
          veilEl()?.classList.remove('is-on');
        };

        /* ---------- 换页薄幕 ----------
           和进度条同一条生命周期：开始加载时拉起，after-swap 时
           给新 DOM 里的那张幕补上（旧节点已经被换掉），page-load 后淡出。

           after-swap 里必须**同步**补类，不能等下一帧：浏览器可能
           在新幕还是透明的时候就画了第一帧，那一帧正是新旧版式
           叠在一起的时刻。 */
        const veilEl = () => document.getElementById('page-veil');
        let veilTimer = 0;
        const raiseVeil = () => {
          const el = veilEl();
          if (!el || reduce) return;
          clearTimeout(veilTimer);
          el.classList.add('is-on');
        };
        const dropVeil = (delay = 0) => {
          clearTimeout(veilTimer);
          veilTimer = window.setTimeout(() => veilEl()?.classList.remove('is-on'), delay);
        };

        if (!window.__routeBar) {
          window.__routeBar = true;

          document.addEventListener('astro:before-preparation', () => {
            const el = barEl();
            if (!el) return;
            clearTimeout(failsafe);
            el.className = 'route-progress is-loading';
            raiseVeil();
            failsafe = window.setTimeout(resetBar, 8000);
          });
          document.addEventListener('astro:after-preparation', () => {
            barEl()?.classList.add('is-ready');
          });
          document.addEventListener('astro:after-swap', () => {
            const el = barEl();
            if (el) el.className = 'route-progress is-loading is-ready';
            raiseVeil();
          });
          document.addEventListener('astro:page-load', () => {
            const el = barEl();
            if (!el) return;
            clearTimeout(failsafe);
            // 留一帧让新幕真正上屏，再开始淡出；否则快速导航时可能完全看不见
            dropVeil(80);
            if (!el.classList.contains('is-loading')) {
              resetBar();
              return;
            }
            el.classList.remove('is-loading', 'is-ready');
            el.classList.add('is-done');
            window.setTimeout(resetBar, 420);
          });
        }

        /* ---------- 数字滚动 ---------- */
        let counterIO = null;

        const countUp = (el) => {
          const target = Number(el.dataset.count || 0);
          if (!Number.isFinite(target)) return;
          if (reduce) {
            el.textContent = String(target);
            return;
          }
          const started = performance.now();
          const duration = 900;
          const tick = (now) => {
            const p = Math.min((now - started) / duration, 1);
            const eased = 1 - Math.pow(1 - p, 3);
            el.textContent = String(Math.round(target * eased));
            if (p < 1) requestAnimationFrame(tick);
          };
          requestAnimationFrame(tick);
        };

        const setupCounters = () => {
          if (counterIO) counterIO.disconnect();
          const els = document.querySelectorAll('[data-count]');
          if (!els.length) return;
          /* 开场层还盖着时只把数字归零，不启动滚动。
             它们挂在 site:intro-done 上重跑一次，和首屏入场同时开始。
             不能只看 is-intro：退场动画期间这个类还在，数字还是起不来。 */
          if (
            document.documentElement.classList.contains('is-intro') &&
            !window.__introDone
          ) {
            els.forEach((el) => {
              el.textContent = '0';
            });
            return;
          }
          if (reduce) {
            els.forEach((el) => {
              el.textContent = el.dataset.count || '0';
            });
            return;
          }
          counterIO = new IntersectionObserver(
            (entries) => {
              for (const entry of entries) {
                if (!entry.isIntersecting) continue;
                countUp(entry.target);
                counterIO.unobserve(entry.target);
              }
            },
            { threshold: 0.5 },
          );
          els.forEach((el) => {
            el.textContent = '0';
            counterIO.observe(el);
          });
        };

        /* ---------- 首屏光标光斑：一个 40rem 的渐变圆跟着指针平移 ---------- */
        const setupSpot = () => {
          const hero = document.querySelector('.hero');
          const spot = hero?.querySelector('[data-hero-spot]');
          if (!hero || !spot || reduce) return;
          if (!window.matchMedia('(hover: hover) and (pointer: fine)').matches) return;
          if (hero.dataset.spotBound === '1') return;
          hero.dataset.spotBound = '1';

          let raf = 0;
          let x = 0;
          let y = 0;

          hero.addEventListener(
            'pointermove',
            (event) => {
              const rect = hero.getBoundingClientRect();
              x = event.clientX - rect.left;
              y = event.clientY - rect.top;
              spot.classList.add('is-on');
              if (raf) return;
              raf = requestAnimationFrame(() => {
                raf = 0;
                spot.style.transform = `translate3d(${x}px, ${y}px, 0)`;
              });
            },
            { passive: true },
          );

          hero.addEventListener('pointerleave', () => {
            spot.classList.remove('is-on');
          });
        };

        /* ---------- 卡片聚光：把指针位置写进 CSS 变量，由 ::after 画出来 ---------- */
        const setupCards = () => {
          if (reduce) return;
          for (const card of document.querySelectorAll('.card')) {
            if (card.dataset.spotBound === '1') continue;
            card.dataset.spotBound = '1';

            let raf = 0;
            let x = 0;
            let y = 0;

            card.addEventListener(
              'pointermove',
              (event) => {
                const rect = card.getBoundingClientRect();
                x = event.clientX - rect.left;
                y = event.clientY - rect.top;
                if (raf) return;
                raf = requestAnimationFrame(() => {
                  raf = 0;
                  card.style.setProperty('--spot-x', `${x}px`);
                  card.style.setProperty('--spot-y', `${y}px`);
                });
              },
              { passive: true },
            );
          }
        };

        /* ---------- 内页指针光晕 ----------
           首页已经有 .hero__spot，再叠一层只会把标题背后的光搅浑，
           所以只在没有 .hero 的页面上开。

           和 hero spot 的区别：这个是**整页**跟着指针走，位于 backdrop
           内部（z-index:-1），不会盖住正文，也不吃 pointer 事件。
           监听只绑一次，页面换掉后由 #pointer-aura 的现查拿到新节点。 */
        const setupAura = () => {
          const aura = document.getElementById('pointer-aura');
          if (!aura || reduce) return;
          if (!window.matchMedia('(hover: hover) and (pointer: fine)').matches) return;

          window.__auraOn = !document.querySelector('.hero');
          if (!window.__auraOn) {
            aura.classList.remove('is-on');
            return;
          }

          if (window.__auraBound) return;
          window.__auraBound = true;

          let raf = 0;
          let x = window.innerWidth / 2;
          let y = window.innerHeight * 0.42;

          const paint = () => {
            raf = 0;
            const el = document.getElementById('pointer-aura');
            if (!el || !window.__auraOn) return;
            el.style.transform = `translate3d(${x}px, ${y}px, 0)`;
            el.classList.add('is-on');
          };

          window.addEventListener(
            'pointermove',
            (event) => {
              if (!window.__auraOn) return;
              x = event.clientX;
              y = event.clientY;
              if (!raf) raf = requestAnimationFrame(paint);
            },
            { passive: true },
          );

          document.addEventListener('pointerleave', () => {
            document.getElementById('pointer-aura')?.classList.remove('is-on');
          });
        };

        const init = () => {
          setupCounters();
          setupSpot();
          setupCards();
          setupAura();
        };

        document.addEventListener('astro:page-load', init);
        // 开场层开始退场后再启动计数（没有开场层时这条事件不会发生）
        window.addEventListener('site:intro-done', init);
        if (document.readyState !== 'loading') init();
      })();
    </script>
  </body>
</html>
